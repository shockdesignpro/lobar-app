{
  "expo": {
    "name": "Lobar Parda",
    "slug": "lobar-parda",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.lobarparda.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e6f5f1",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.lobarparda.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Lobar Parda",
      "shortName": "Lobar",
      "themeColor": "#0d7a5f",
      "backgroundColor": "#f4f6f5"
    },
    "scheme": "lobarparda",
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0d7a5f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Andoza rasmlarini buyurtmaga qo‘shish uchun galereyaga ruxsat kerak.",
          "cameraPermission": "Andoza rasmini kamerada olish uchun ruxsat kerak.",
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
