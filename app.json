{
  "expo": {
    "name": "Lobar Parda",
    "slug": "lobar-parda",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.lobarparda.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faefe6",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.lobarparda.app",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Lobar Parda",
      "shortName": "Lobar",
      "themeColor": "#0d7a5f",
      "backgroundColor": "#f4f6f5"
    },
    "scheme": "lobarparda",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0d7a5f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Andoza rasmlarini buyurtmaga qo‘shish uchun galereyaga ruxsat kerak.",
          "cameraPermission": "Andoza rasmini kamerada olish uchun ruxsat kerak.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Chek rasmini galereyaga saqlash uchun ruxsat kerak.",
          "savePhotosPermission": "Chek rasmini galereyaga saqlash uchun ruxsat kerak.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withAbis.js"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "0e0f5120-82c1-4e6e-98d7-bf844d2f3109"
      }
    },
    "owner": "shockdesignpro",
    "updates": {
      "url": "https://u.expo.dev/0e0f5120-82c1-4e6e-98d7-bf844d2f3109"
    }
  }
}
